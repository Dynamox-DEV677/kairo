# ─── Server ────────────────────────────────────────────────────────────────
PORT=4000

# ─── Encryption ─────────────────────────────────────────────────────────────
# 32-byte hex secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING

# ─── OpenRouter (AI email content) ──────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
AI_MODEL=openai/gpt-oss-20b:free

# ─── Database (NeDB — v1/v2 features) ───────────────────────────────────────
DB_PATH=./kairo.db

# ─── Supabase (v4 multi-tenant SaaS) ────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY

# ─── CORS ───────────────────────────────────────────────────────────────────
# Allowed production origin (local origins are auto-allowed)
ALLOWED_ORIGIN=https://your-kairo-frontend.vercel.app
