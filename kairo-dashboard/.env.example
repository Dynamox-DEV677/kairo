# ── Frontend ────────────────────────────────────────────────────────────────
# Backend URL — set this in Vercel → Project Settings → Environment Variables.
# In development this defaults to http://localhost:4000/api automatically.
VITE_API_BASE=https://your-kairo-backend.up.railway.app/api

# ── Backend: core ───────────────────────────────────────────────────────────
# 32+ char random string used for credential encryption + reset-token signing.
ENCRYPTION_SECRET=change-me-to-a-32-plus-char-random-string

# Comma-separated allowlist of public origins. First entry is also the public
# app URL used in emails (`appUrl()` in server/email/theme.js).
ALLOWED_ORIGIN=https://kairo-daily-edu.vercel.app

# ── Backend: AI (Groq — the only provider) ──────────────────────────────────
# Comma-separate multiple keys to rotate the free-tier pool (recommended).
GROQ_API_KEYS=gsk_your-groq-key-1,gsk_your-groq-key-2

# ── Backend: Email (platform Gmail used for ALL auth + transactional emails) ──
# Required for the premium email auth system to actually send. If missing,
# the system silently no-ops so auth still works in dev.
KAIRO_EMAIL=your-platform-account@gmail.com
KAIRO_EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional — overrides the default "Kairo · Accelerate Your Academics" display name
# KAIRO_EMAIL_FROM_NAME=Kairo

# Password reset token TTL in minutes (default 30). Min 5.
# RESET_TOKEN_TTL_MINUTES=30

# In production, the /api/dev/emails preview routes return 404 by default.
# Set this to 1 to enable previews on a staging deploy.
# KAIRO_ALLOW_EMAIL_PREVIEW=1

# ── Backend: Supabase ───────────────────────────────────────────────────────
# Used for multi-tenant auth + user storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi…

# ── Backend: Payments (optional) ────────────────────────────────────────────
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
